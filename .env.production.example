# Production template. Copy to .env on the server, fill the secrets, then run: php artisan app:preflight

APP_NAME=EduSmart
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://api.myapp.dz
APP_TIMEZONE=Africa/Algiers
LOG_LEVEL=warning

# Database (MySQL 8 / MariaDB, or PostgreSQL). Never SQLite in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edusmart
DB_USERNAME=edusmart
DB_PASSWORD=

# Shared stores (rate limits, 2FA challenges, tenant cache, scheduler locks)
CACHE_STORE=database          # or redis
QUEUE_CONNECTION=database
SESSION_DRIVER=array

# Front-end and proxy
CORS_ALLOWED_ORIGINS=https://app.myapp.dz
TRUSTED_PROXIES=              # the load balancer address(es), or * if it is the only way in
TENANCY_BASE_DOMAIN=myapp.dz  # "school.myapp.dz" resolves to the tenant "school"

# Authentication (defaults are already safe; shown for reference)
TENANT_TOKEN_TTL_MINUTES=60
PLATFORM_TOKEN_TTL_MINUTES=30
IMPERSONATION_REQUIRE_2FA=true

# Business
TRIAL_DAYS=30
TRIAL_PLAN=standard
SUBSCRIPTION_GRACE_DAYS=7

# Messaging drivers: log | null | a class implementing App\Support\Messaging\ChannelDriver
MESSAGING_SMS_DRIVER=log
MESSAGING_WHATSAPP_DRIVER=log
MESSAGING_EMAIL_DRIVER=log

# Backups (daily at BACKUP_TIME, encrypted with the passphrase: keep the passphrase somewhere other than the server)
BACKUP_ENABLED=true
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=
